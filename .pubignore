# pubignore — overrides .gitignore when present; mirror dev-only paths here.

# Dart / Flutter
.dart_tool/
.flutter-plugins-dependencies
**/doc/api/
build/
coverage/
pubspec.lock

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Docs
/docs/

# AI tooling
.claude/
CLAUDE.md

# Tests
/test/
dart_test.yaml

# Branding stays on GitHub: the README loads the diagrams and the
# screenshots from there. Only the icon ships, as the pubspec screenshot.
/imgs/*
!/imgs/dart_smb2.png

# Dev tools: ffigen, the drift check, the release updater, the icon and
# diagram generator
/tool/
